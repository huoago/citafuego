# Public application configuration
NEXT_PUBLIC_APP_URL=https://citafuego.com
NEXT_PUBLIC_SUPABASE_URL=https://stfbybkutnoqoxhqxyou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never commit real values.
# Username/password account mapping and other privileged server operations use
# the modern Supabase secret key. Legacy service_role remains supported during migration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth delivery gates. Keep false until the matching provider is verified in production.
# Email registration/binding requires a production sender plus a Supabase confirmation template that renders {{ .Token }} as a 6-digit OTP for signup.
EMAIL_AUTH_PRODUCTION_READY=false
EMAIL_AUTH_DELIVERY_MODE=otp_code
# Phone signup/binding stays hidden and its API fails closed unless the SMS provider has been tested end-to-end.
PHONE_AUTH_PRODUCTION_READY=false

# Trust & Safety provider adapters
MODERATION_PROVIDER=rules
MODERATION_API_KEY=
VERIFICATION_PROVIDER=manual_selfie
VERIFICATION_API_KEY=
PROFILE_PHOTO_REVIEW_MODE=manual
VERIFICATION_REVIEW_MODE=manual

# Billing provider adapter
PAYMENTS_PROVIDER=disabled
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Optional TURN relay for random voice/video. STUN fallback works without these,
# but TURN is strongly recommended for carrier-grade connectivity.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Production Auth email / SMTP documentation variables.
SMTP_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@auth.citafuego.com
