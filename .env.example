# Public application configuration
NEXT_PUBLIC_APP_URL=https://citafuego.com
NEXT_PUBLIC_SUPABASE_URL=https://stfbybkutnoqoxhqxyou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase secrets for other privileged backend jobs.
# Cuenta + Contraseña does NOT require copying a Supabase admin key to Vercel;
# its privileged work stays inside the Supabase Edge Function and Vercel authenticates with its automatically injected OIDC token.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth delivery gates. Keep false until the matching provider is verified in production.
# Email registration/binding requires a production sender plus a Supabase confirmation template that renders {{ .Token }} as a 6-digit OTP for signup.
EMAIL_AUTH_PRODUCTION_READY=false
EMAIL_AUTH_DELIVERY_MODE=otp_code
# Phone signup/binding stays hidden and its API fails closed unless the SMS provider has been tested end-to-end.
PHONE_AUTH_PRODUCTION_READY=false

# Trust & Safety provider adapters.
# Profile photos use Vercel AI Gateway with the per-request Vercel OIDC token by default;
# no long-lived visual moderation API key needs to be copied into the app.
MODERATION_PROVIDER=auto
VISUAL_MODERATION_MODEL=google/gemini-3.6-flash
MODERATION_API_KEY=
VERIFICATION_PROVIDER=manual_selfie
VERIFICATION_API_KEY=
PROFILE_PHOTO_REVIEW_MODE=automatic
VERIFICATION_REVIEW_MODE=manual
# Optional specialized fallback/override. When configured, Sightengine can be selected with MODERATION_PROVIDER=sightengine.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Billing provider adapter
PAYMENTS_PROVIDER=disabled
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Optional TURN relay for random voice/video. STUN fallback works without these,
# but TURN is strongly recommended for carrier-grade connectivity.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Production Auth email / SMTP documentation variables.
SMTP_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@auth.citafuego.com
